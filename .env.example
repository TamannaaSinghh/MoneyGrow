# Sanity — copy to .env.local and fill in your project values.
# Find these in https://www.sanity.io/manage (your project → API / Project ID).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-06-01

# Sanity read token — server-side, used by the site to read documents when the
# dataset isn't anonymously readable. A least-privilege "Viewer" token is enough.
SANITY_API_READ_TOKEN=

# Sanity write token — ONLY for the one-time team seed (scripts/seed-team.mjs).
# Editor token from sanity.io/manage → project → API → Tokens. Secret; never commit.
SANITY_API_WRITE_TOKEN=

# Mailchimp — newsletter signup (footer form). Server-side only (kept secret).
# API key:      Mailchimp → Profile → Extras → API keys
# Audience ID:  Audience → Settings → "Audience name and defaults" → Audience ID
# Server prefix is the bit after the dash in the API key (e.g. us21); optional
# if you keep the full key here, it's derived automatically.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=
# Set to "true" to require email confirmation (double opt-in). Default: false.
MAILCHIMP_DOUBLE_OPT_IN=false
